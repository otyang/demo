# Example configuration for local development. Copy it to .env to change
# values; cmd/api loads .env when it exists and this file otherwise.
# Variables already set in the environment win.

# Application
DEMO_APP_NAME=demo-api
DEMO_DEBUG=true
DEMO_LOG_LEVEL=info
DEMO_HOST=localhost:3000
# Browser origins allowed to call the API (comma-separated); empty allows
# none. The API reference (go run ./doc) runs on localhost:8080.
DEMO_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Database: sqlite (a local file, nothing to install) or postgres, e.g.
# DEMO_DB_TYPE=postgres
# DEMO_DB_URL=postgres://user:password@localhost:5432/demo?sslmode=disable
DEMO_DB_TYPE=sqlite
DEMO_DB_URL=file:demo.db
DEMO_DB_TIMEOUT=5s
DEMO_DB_POOL_SIZE=10

# Auth, local mode: skip JWT checks and give every request these fixed claims.
# Requires DEMO_DEBUG=true; never enable it in production.
DEMO_AUTH_TEST_CLAIMS=true
DEMO_AUTH_TEST_ORG_ID=org_demo
DEMO_AUTH_TEST_PERMISSIONS=tasks:read,tasks:write

# Auth, real mode (DEMO_AUTH_TEST_CLAIMS=false): Bearer tokens are verified
# against your identity provider's keys. All three are then required.
DEMO_AUTH_JWKS_URL=
DEMO_AUTH_ISSUER=
DEMO_AUTH_AUDIENCE=
